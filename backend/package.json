{
  "name": "olimpiade-matematika-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API Website Olimpiade Matematika (Express + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
