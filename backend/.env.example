PORT=3000
NODE_ENV=development

# Wajib diganti dengan string acak panjang di production
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Lokasi file SQLite (relatif terhadap folder backend)
DB_PATH=./data/olimpiade.db

# Daftar origin front-end yang diizinkan, pisahkan dengan koma
CORS_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=10

# Akun admin yang dibuat oleh seed (ganti password sebelum deploy)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@olimpiade.local
ADMIN_PASSWORD=Admin12345
